    "@google/genai": "^2.8.0",
    "@neondatabase/serverless": "^1.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "replicad-threejs-helper": "^0.23.0",
